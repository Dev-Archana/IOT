const express = require('express');
const bodyParser = require('body-parser');

const app = express();
const PORT = 3000;

// Middleware to parse JSON requests
app.use(bodyParser.json());

// Route to log received data
app.post('/api/log', (req, res) => {
    const { randomNumber, ledState } = req.body;

    // Print received data to the console
    console.log(`Received Data: Random Number = ${randomNumber}, LED State = ${ledState}`);

    // Respond back
    res.status(200).json({ status: 'success', message: 'Data received successfully' });
});

// Start the server
app.listen(PORT, () => {
    console.log(`Server is running on http://localhost:${PORT}`);
});

