#include <WiFi.h>
#include <HTTPClient.h>

// WiFi Credentials
const char* ssid = "Archana";
const char* password = "archanasm";

// Server URL
const char* serverName = "http://192.168.119.167:3000/api/log"; // Replace with your Node.js server IP

const int ledPin = 42; // Pin for the LED

void setup() {
  pinMode(ledPin, OUTPUT); // Set the LED pin as an OUTPUT
  Serial.begin(115200);

  // Connect to WiFi
  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\nConnected to WiFi");
}

void loop() {
  // Generate a random number
  int randomNumber = random(1, 101); // Random number between 1 and 100
  String ledState;

  // Determine LED state based on the random number
  if (randomNumber % 2 == 0) {
    ledState = "ON";
    digitalWrite(ledPin, HIGH); // Turn the LED ON
  } else {
    ledState = "OFF";
    digitalWrite(ledPin, LOW); // Turn the LED OFF
  }

  // Print the generated data
  Serial.print("Generated Number: ");
  Serial.println(randomNumber);
  Serial.print("LED ");
  Serial.println(ledState);

  // Prepare JSON payload
  String jsonPayload = "{\"randomNumber\":" + String(randomNumber) + ",\"ledState\":\"" + ledState + "\"}";

  // Send the data to the server
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(serverName);
    http.addHeader("Content-Type", "application/json");

    int httpResponseCode = http.POST(jsonPayload);

    if (httpResponseCode > 0) {
      String response = http.getString();
      Serial.println("Response: " + response);
    } else {
      Serial.println("Error Sending Data: " + String(httpResponseCode));
    }
    http.end();
  } else {
    Serial.println("WiFi Disconnected");
  }

  delay(5000); // Wait 5 seconds before sending the next request
}
